# ============================================================================
# J&J Flooring World dashboard
# Copy to .env.local and fill in as the backend comes online.
# ============================================================================

# Postgres connection strings. Required.
# Neon: DATABASE_URL is the pooled "-pooler" host with pgbouncer=true;
# DIRECT_URL is the plain host, used by prisma migrate.
DATABASE_URL=
DIRECT_URL=

# --- Auth -------------------------------------------------------------------

# 32-byte key, base64-encoded, used to encrypt the GHL private integration
# token at rest (AES-256-GCM). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required once a GHL connection is saved; not needed just to log in.
ENCRYPTION_KEY=

# The first Admin account, created by `npm run db:seed`. Required for the
# seed script to create an admin; harmless to leave unset afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# Used to build the links inside invite/reset emails. Defaults to
# http://localhost:3000 if unset.
APP_URL=

# --- Frontend / mock API toggle ----------------------------------------------
# Governs the still-mock product/lead/job/estimate/invoice modules only.
# Authentication always talks to the real database, regardless of this flag.

# Which data source the app talks to.
#
#   (unset)        Mock, in-memory repository. No server needed.
#   false          Real API. NEXT_PUBLIC_API_BASE_URL is then required.
#   true           Force the mock, even when a base URL is set.
#
# Defaults to "mock" while NEXT_PUBLIC_API_BASE_URL is empty.
NEXT_PUBLIC_USE_MOCK_API=

# Origin of the API, including any version prefix. Empty means same origin.
NEXT_PUBLIC_API_BASE_URL=

# Request timeout in milliseconds. Defaults to 20000.
NEXT_PUBLIC_API_TIMEOUT_MS=

# --- First-run setup and GHL auto-login ---------------------------------------
# /setup asks for SETUP_KEY; setup can only be completed once.
SETUP_KEY=
# Required as ?key=... on GHL custom menu links (/csr/{{user.id}}, /sales-rep/{{user.id}}).
GHL_AUTOLOGIN_KEY=
# Extra domains allowed to embed the app in an iframe (white-label GHL domain), space separated.
GHL_FRAME_ANCESTORS=
