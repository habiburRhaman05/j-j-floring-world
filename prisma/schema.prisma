enum JobPhotoType {
  BEFORE
  PROGRESS
  COMPLETION
  ISSUE
  MATERIAL_DELIVERY
}

enum JobIssueSeverity {
  LOW
  MEDIUM
  HIGH
  BLOCKING
}

enum JobIssueStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  WONT_FIX
}

enum MaterialOrderStatus {
  NOT_ORDERED
