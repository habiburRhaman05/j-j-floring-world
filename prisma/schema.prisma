// =============================================================================
// J&J Flooring World - Prisma schema
// PostgreSQL 15+ · Prisma 5+
//
// Conventions used throughout:
//  · Money: Decimal(14,4) for per-unit rates (a floor price of $2.185/SF is
//    real), Decimal(14,2) for totals. Never Float.
//  · Margin is NEVER a column. It is derived from snapshotted cost and price.
//  · Records with financial or legal consequence are never hard-deleted.
//    Catalogue and people records carry deletedAt; money records do not and
//    are voided instead.
//  · Every entity mirrored from GoHighLevel carries a nullable, unique
//    ghl*Id column plus a SyncState row. Field write-ownership is declared in
//    SyncFieldPolicy - see docs/05-ghl-sync-architecture.md.
//  · Single tenant by decision D1. No companyId anywhere. If multi-tenancy is
//    ever needed, add companyId + a Prisma extension that scopes every query.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  APPOINTMENT_SET
  ESTIMATE_SENT
  FOLLOW_UP
  WON
  LOST
}

enum LeadSource {
  FACEBOOK_ADS
  GOOGLE_ADS
  WEBSITE_FORM
  ORGANIC_SEARCH
  REFERRAL
  WALK_IN
  INBOUND_CALL
  REPEAT_CUSTOMER
  OTHER
}

enum LeadLostReason {
  PRICE
  TIMELINE
  WENT_ELSEWHERE
  NO_RESPONSE
  NOT_QUALIFIED
  DUPLICATE
  SPAM
  OTHER
}

enum AssignmentStrategy {
  CSR_MANUAL // primary path, decision D5
  ADMIN_OVERRIDE
  AUTO_ROUND_ROBIN
  AUTO_TERRITORY
  AUTO_LOAD_BALANCED
  AUTO_SOURCE_RULE
  SLA_FALLBACK // auto fired because the CSR SLA expired
}

enum ActivityType {
  CALL_OUTBOUND
  CALL_INBOUND
  SMS
  EMAIL
  SITE_VISIT
  NOTE
  STAGE_CHANGE
